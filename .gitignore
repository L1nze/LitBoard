# ---------- 依赖 ----------
# 本项目约定项目目录零依赖：构建工具装在 %LOCALAPPDATA%\LitBoardBuildTools。
# 若你选择了标准 npm 流程（见 CONTRIBUTING.md），node_modules 不入库。
node_modules/
npm-debug.log*

# ---------- 构建产物 ----------
# 应用图标 build/icon.ico 与 build/icon-*.png 是源文件，必须入库，勿在此忽略 build/
dist/
build/win-unpacked/
*.blockmap
builder-debug.yml
builder-effective-config.yaml

# ---------- 测试与冒烟产物 ----------
coverage/
test/artifacts/
test/smoke-*.json
.tmp/
extension/js/

# ---------- 本地数据（绝不入库）----------
# 这些文件默认写在配置目录（%APPDATA%\LitBoard 或自选目录），正常不会出现在仓库里；
# 这里全部兜底忽略，防止把数据目录指到仓库内、或往仓库拷贝文件时误提交。
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite.bak
*.bak
*.stamp
*.corrupt-*
*.db
# 凭据与同步状态（integrations.json 内含 safeStorage 加密的 WebDAV/API 凭据；
# sync-conflicts.jsonl 含被覆盖版本的内容快照）
integrations.json
data-paths.json
litboard-library.json
sync-base.json
sync-asset-ledger.json
sync-conflicts.jsonl
# AI 会话与调研库、受管附件等数据目录（仅兜底仓库根一级）
/会话记录/
/research/
/ocr/
/note-assets/
/restored-assets/
/tmp-fulltext/
/attachments/
.env
.env.*
*.local.json

# ---------- 编辑器 / 系统 ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

# ---------- 工具与预览残留（不入库）----------
.icon-previews/
.zcode/

# ---------- AI 工作区说明（本机维护，不入库）----------
# AGENTS.md 是给 AI 助手的精简版工程约定，AGENTS_DETAIL.md 是详细对照（踩坑/决策全记录）。
# 两者随 OneDrive 同步；新机器 clone 后需手动放回仓库根目录。
/AGENTS.md
/AGENTS_DETAIL.md

# ---------- 本地工作记录与内部文档（不入库）----------
/CHANGELOG.md
/docs/audits/agent-*.md
/docs/handoff-ocr-epub.md
/docs/refactor-app-slim-plan.md
/docs/task-ledger.md
/docs/audit-baseline.md
/docs/roadmap.md
/docs/releasing.md
/docs/limitations.md
# 录屏原件不随演示 GIF 一起发布。
docs/assets/gif/*.mp4
# ---------- 一次性探针与本地调试脚本 ----------
/scripts/one-off/

/test/*
!/test/agent-files.test.js
!/test/agent-reference.test.js
!/test/agent-reference-ui.test.js
!/test/agentfork.test.js
!/test/agent-fork-ui.test.js
!/test/attachment-multipdf.test.js
!/test/folder-delete.test.js
!/test/folder-import-flow.test.js
!/test/folder-drop-routing.test.js
!/test/folder-selection.test.js
!/test/foldertree.test.js
!/test/library-crud.test.js
!/test/pdf-open-race.test.js
!/test/paper-folder-drag.test.js
!/test/research-fetch-page.test.js
!/test/research-semantic-search.test.js
!/test/update.test.js
!/test/update-check.test.js
!/test/files-ipc.test.js
.zcodeignore

!test/agent-operations.test.js

!test/agent-context-ui.test.js

!test/agentfilecontext.test.js
!test/agentplan.test.js

!test/agentdispatch.test.js

!test/agent-tool-cancel.test.js
